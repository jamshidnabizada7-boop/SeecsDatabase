# ============================================================
# DEV (sandbox) - uses a local SQLite file so the project runs
# out of the box with `bun run db:push`.
# ============================================================
DATABASE_URL="file:../db/custom.db"

# ============================================================
# PRODUCTION on NEON (PostgreSQL):
#   1) In prisma/schema.prisma change `provider = "sqlite"` to `provider = "postgresql"`
#   2) Replace DATABASE_URL with your Neon string:
#        DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/seecs?sslmode=require
#   3) bun run db:push
# ============================================================

# Master admin password fallback (only used for the very first seed).
# After first run, change it from the Admin Settings UI.
ADMIN_BOOTSTRAP_EMAIL=admin@seecs.nust.edu.pk
ADMIN_BOOTSTRAP_PASSWORD=admin12345
